{
  "expo": {
    "name": "Memo Trip",
    "slug": "memo_trip",
    "version": "1.0.1",
    "orientation": "default",
    "scheme": "memo-trip",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/screenshots/MemoTrip_Logo.png",
    "splash": {
      "image": "./assets/screenshots/MemoTrip_Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.tentzer.memotrip",
      "buildNumber": "14",
      "usesAppleSignIn": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "waze",
          "comgooglemaps",
          "googlemaps",
          "maps",
          "waze",
          "comgooglemaps",
          "googlemaps",
          "maps"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": ""
      }
    },
    "android": {
      "package": "com.tentzer.memotrip",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/screenshots/MemoTrip_Logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cc2d2c16-14c2-431f-8ba8-155c89bbe5db",
      "checkAutomatically": "ON_LOAD"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "cc2d2c16-14c2-431f-8ba8-155c89bbe5db"
      }
    },
    "owner": "tentzer"
  }
}
